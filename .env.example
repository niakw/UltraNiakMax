# TMDB key is required. All other integrations are optional.
TMDB_KEY=replace_with_your_tmdb_key
MDBLIST_KEY=
TRAKT_CLIENT_ID=
GOOGLE_AI_KEY=

# Reverse proxy: 0 = no trusted proxy; 1 = one trusted HTTPS reverse proxy.
TRUST_PROXY_HOPS=0
HOST_PORT=7000

# Set for the optional /admin/stats endpoint (use a long, random string).
STATS_SECRET=
